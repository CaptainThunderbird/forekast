{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "node index.js",
    "start": "node index.js",
    "test": "node --test tests/*.test.js",
    "generate": "prisma generate --config=prisma.config.ts",
    "validate": "prisma validate --config=prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config=prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config=prisma.config.ts"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "^7.9.0",
    "supertest": "^7.1.4"
  }
}

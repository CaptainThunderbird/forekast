generator client {
  provider               = "prisma-client"
  output                 = "./generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  bio           String?
  avatarUrl     String?   @db.VarChar(1000)
  createdAt     DateTime  @default(now())

  forecasts     Forecast[]
  signals       Signal[]

  // Self-referencing many-to-many for follows.
  // "following" = the users THIS user follows
  // "followers" = the users who follow THIS user
  following     Follow[]  @relation("Follower")
  followers     Follow[]  @relation("Following")

  @@map("users")
}

model Forecast {
  id         String         @id @default(uuid())
  statement  String         @map("content") @db.VarChar(280)
  reasoning  String?        @db.VarChar(2000)
  category   Category       @default(OTHER)
  targetDate DateTime?
  status     ForecastStatus @default(OPEN)
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  signals   Signal[]
  resolution Resolution?

  @@index([userId])
  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("tweets")
}

model Resolution {
  id          String         @id @default(uuid())
  result      ForecastStatus
  explanation String         @db.VarChar(2000)
  sourceUrl   String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now())

  forecastId String   @unique
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@map("resolutions")
}

model Signal {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  forecastId String   @map("tweetId")
  forecast   Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  // a user can only like a given tweet once
  @@unique([userId, forecastId])
  @@map("likes")
}

enum Category {
  TECHNOLOGY
  BUSINESS
  SCIENCE
  POLITICS
  SPORTS
  CULTURE
  OTHER
}

enum ForecastStatus {
  OPEN
  CORRECT
  INCORRECT
  INCONCLUSIVE
}

model Follow {
  createdAt   DateTime @default(now())

  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  // the pair itself is the primary key — can't follow the same person twice
  @@id([followerId, followingId])
  @@map("follows")
}
